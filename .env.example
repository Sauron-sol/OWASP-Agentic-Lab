# The labs run fully offline by default with a deterministic scripted planner.
# There is no API key required to complete any lab.
AGENT_MODEL=scripted

# Optional: run the same labs against a real model instead.
#   AGENT_MODEL=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
# Real models are non-deterministic. Attack output will vary; the defense
# tests are written against the scripted planner and are what you grade on.
